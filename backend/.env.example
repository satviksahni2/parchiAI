# Meta WhatsApp Cloud API credentials
WHATSAPP_TOKEN=EAAG...your_meta_system_user_token
VERIFY_TOKEN=parchai_secure_token
WHATSAPP_API_VERSION=v20.0

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy...your_gemini_key
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Integration (gspread)
# Spreadsheet title must be 'ParchAI_Data' or your chosen name
SHEETS_SPREADSHEET_NAME=ParchAI_Data
SERVICE_ACCOUNT_FILE=service_account.json
# Or paste entire service_account.json content into this env var for Render/Cloud:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Port & Server Host
PORT=8000
HOST=0.0.0.0
